# Python
__pycache__/
*.pyc

# Environments
env_RectifiedTraj

# Model / array files
*.pt
*.safetensors
*.npy

# Dataset: ignore files, keep folders
dataset/**
!dataset/**/.gitkeep

# Experiment outputs (derived)
bin/**
!bin/**/.gitkeep

# Track baseline_model (note: contains another repo)
!bin/baseline_model
!bin/baseline_model/**
!bin/baseline_model/difftraj
!bin/baseline_model/difftraj/**

# Track model directory (only specific checkpoint + log)
!bin/model
!bin/model/**
# In-progress training outputs (do not track yet)
bin/model/ResidualReg/
bin/model/RectifiedTraj_no_chunk/

# Track bin/log folder but ignore contents (keep gitkeep only)
!bin/log
bin/log/**
!bin/log/.gitkeep

!bin/test_result
bin/test_result/**
!bin/test_result/.gitkeep

archived
archive
report
wandb

# Valhalla runtime cache (generated)
src/baseline/models/valhalla_meili/runtime/**
!src/baseline/models/valhalla_meili/runtime/.gitkeep
