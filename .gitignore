# Python
__pycache__/
*.pyc

# Environments
env_RectifiedTraj

# Model / array files
*.pt
*.safetensors
*.npy

# Dataset: ignore files, keep folders
dataset/**
!dataset/**/.gitkeep

# Experiment outputs (derived)
bin/**
!bin/**/.gitkeep

# Track baseline_model (note: contains another repo)
!bin/baseline_model
