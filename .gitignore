# Python
__pycache__/
*.pyc

# Environments
env_RectifiedTraj/

# Model / array files
*.pt
*.safetensors
*.npy

# Dataset: keep only transformed calibration state in git
dataset/**
!dataset/
!dataset/raw/
!dataset/raw/BlogWatcher/
dataset/raw/BlogWatcher/**
!dataset/raw/BlogWatcher/.gitkeep
!dataset/state/
!dataset/state/calib.json

# Outdated local source docs/templates
src/protocol/
src/utils/config_template/

# Experiment outputs (derived)
bin/**
!bin/
!bin/test_results/
bin/test_results/**
!bin/test_results/.gitkeep

# Track baseline_model (note: contains another repo)
!bin/baseline_model
!bin/baseline_model/**
!bin/baseline_model/difftraj
!bin/baseline_model/difftraj/**

# Track archived online model summaries only: best checkpoint, logs, and figures.
!bin/model/
!bin/model/*_online/
!bin/model/*_online/*/
!bin/model/*_online/*/best_ckpt/
!bin/model/*_online/*/best_ckpt/**
!bin/model/*_online/*/log/
!bin/model/*_online/*/log/**
!bin/model/*_online/*/fig/
!bin/model/*_online/*/fig/**
bin/model/*_online/*/ckpts/
bin/model/*_online/*/ckpts/**

# Track bin/log folder but ignore contents (keep gitkeep only)
!bin/log
bin/log/**
!bin/log/.gitkeep

bin/test_result/

archived/
archive/
report
wandb

# Local agent state
.agent
.agents/
.codex
